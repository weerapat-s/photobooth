# ---------- บูทปริ้น (คัดลอกโฟลเดอร์นี้ไปได้หลายเครื่อง) ----------
PRINTER_ID=print-1          # ต้องไม่ซ้ำกับเครื่องอื่นในงานเดียวกัน (เว้นว่าง = ใช้ชื่อคอม)
PRINT_PORT=4701
PRINTER_NAME=               # ชื่อเครื่องพิมพ์ใน Windows เว้นว่าง = เครื่องพิมพ์เริ่มต้น
PAPER=2x6                   # ตรงกับ strip2x6 (ค่าเริ่มต้น) — เปลี่ยนเป็น 4x6 ถ้าฝั่งบูทถ่ายสลับ PRINT_LAYOUT=grid4x6
AUTO_PRINT=true             # true = เจอคิวแล้วพิมพ์เลย
POLL_SECONDS=5
DRY_RUN=false               # true = ไม่พิมพ์จริง ไว้เทสต์
MAX_COPIES=5
ACCEPT_BOOTHS=              # เว้นว่าง = รับงานจากทุกบูท เช่น "booth-1,booth-2"
STALE_CLAIM_MINUTES=10      # งานที่จองค้างนานเกินนี้ = เครื่องนั้นดับ เอากลับเข้าคิว

# ---------- Nextcloud (ต้องตรงกับเครื่องถ่าย) ----------
NC_BASE=https://nextcloud.ienas.site
NC_SHARE_TOKEN=mTt85rx6nbb7Wya
NC_SHARE_PASSWORD=
NC_ROOT=photobooth
