# ---------- ทั่วไป ----------
PORT=4700
SHOTS=4                     # จำนวนภาพต่อ 1 เซสชัน
COUNTDOWN=3                 # วินาทีนับถอยหลังก่อนแต่ละช็อต (โหมด digicam)
SHOT_GAP_SECONDS=1.5        # เว้นระหว่างช็อต ให้ลูกค้าเปลี่ยนท่า
SESSION_IDLE_SECONDS=25     # โหมด folder: เงียบเกินนี้ = ปิดเซสชันแล้วอัปโหลด
REVIEW_SECONDS=90           # เวลาโชว์ QR บนจอลูกค้าก่อนกลับหน้าแรก
BOOTH_NAME=booth-1
EVENT_NAME=IE Photo Booth
PRINT_ON_DONE=false         # true = จบเซสชันแล้วส่งปริ้นทันที ไม่ต้องกด

# ---------- แหล่งภาพ ----------
# digicam = แอปคุมกล้องผ่าน digiCamControl มี live view บนจอลูกค้า (ต้องปิด Capture One ไม่ให้แย่ง tether)
# folder  = ช่างกดชัตเตอร์เอง Capture One เซฟลงโฟลเดอร์ Capture แล้วแอปหยิบไปใช้ (ไม่มี live view)
# mock    = ภาพปลอม ไว้เทสต์ทั้ง pipeline
CAPTURE_SOURCE=digicam
DCC_TRANSPORT=auto           # auto = ลอง webserver ก่อน ถ้าเปิดไม่ได้ตกไป remotecmd (ไม่มี live view)
DCC_HOST=http://localhost:5513
DCC_PATH=C:\Program Files (x86)\digiCamControl
CAPTURE_DIR=C:\photobooth-captures     # digiCamControl เซฟไฟล์ลงที่นี่ (แยกโฟลเดอร์ต่อเซสชัน)
CAPTURE_TIMEOUT=25000

WATCH_DIR=C:\photobooth-captures       # ใช้เฉพาะโหมด folder — ชี้ไปโฟลเดอร์ Capture ของ Capture One
WATCH_POLLING=false                    # true ถ้าโฟลเดอร์อยู่บนไดรฟ์เน็ตเวิร์ก

# ---------- วิดีโอ ----------
FFMPEG=C:\Program Files (x86)\digiCamControl\ffmpeg.exe
VIDEO_SECONDS=6

# ---------- เลย์เอาต์ปริ้น ----------
PRINT_LAYOUT=strip2x6       # strip2x6 (สตริปพาสเทล 2x6 แถบเดียว) | grid4x6 (2x2 ธีมมืด บนกระดาษ 4x6 พอร์เทรตใบเดียว)
PRINT_DPI=300
PRINT_SHOTS=4                # การ์ด/ชีทปริ้นใช้ช็อตล่าสุด N ภาพ (ขั้นต่ำ 4) - วิดีโอยังใช้ครบทุกช็อต
PRINT_THEME_COLOR=#dff2ef    # สีพื้นหลังธีมการ์ด/ชีทปริ้น (ตายตัวค่าเดียว ปรับได้ในจอช่าง)
PRINT_FRAME_COLOR=#ffffff    # สีกรอบขาวรอบรูปแบบโพลารอยด์
GRID_BG_COLOR=#15151d        # ธีม grid4x6 (เลย์เอาต์เลือกได้): พื้นมืด
GRID_ACCENT_COLOR=#ffe14d    # ธีม grid4x6: สีตัวอักษรเรืองแสง + วงกลมวันที่

# ---------- Nextcloud ----------
NC_BASE=https://nextcloud.ienas.site
NC_SHARE_TOKEN=mTt85rx6nbb7Wya
NC_SHARE_PASSWORD=
NC_ROOT=photobooth          # โฟลเดอร์ย่อยใน share

# บัญชี Nextcloud ไว้สร้าง public share แยกต่อเซสชัน (จำเป็น — ไม่มีไม่ได้เพราะลูกค้าจะเห็นเซสชันคนอื่นได้)
# สร้างที่ Nextcloud > รูปโปรไฟล์ > การตั้งค่าส่วนบุคคล > ความปลอดภัย > Devices & sessions > Create new app password
NC_USER=
NC_APP_PASSWORD=
NC_OWNER_PREFIX=            # โฟลเดอร์ที่ NC_ROOT อยู่ข้างใน นับจาก Files ของบัญชีนี้ (เว้นว่างถ้า NC_ROOT อยู่ที่ราก)

# ---------- บูทปริ้น (เครื่องที่ 2) ----------
PRINT_PORT=4701
PRINTER_NAME=Canon iX6700 series XPS   # เว้นว่าง = เครื่องพิมพ์เริ่มต้นของ Windows
PAPER=2x6                    # ตรงกับ strip2x6 (ค่าเริ่มต้น) — เปลี่ยนเป็น 4x6 ถ้าสลับ PRINT_LAYOUT=grid4x6
AUTO_PRINT=true
POLL_SECONDS=5
DRY_RUN=false               # true = ไม่พิมพ์จริง ไว้เทสต์
